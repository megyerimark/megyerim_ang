# Angular SPA – Apache beállítások (a build a dist/…/browser mappába másolja)

<IfModule mod_rewrite.c>
    RewriteEngine On

    # HTTPS kényszerítése (proxy / Cloudflare mögött az X-Forwarded-Proto alapján)
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # A Laravel backend útvonalai nem az Angularhoz mennek
    RewriteRule ^(api|sanctum|storage)(/|$) - [L]
    RewriteRule ^admin/(login|logout|forgot-password|reset-password|verify-login|resend-login-code)$ - [L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    # Csak saját domainről tölthető be szkript, betűtípus és adat. Inline stílus az Angular komponensek miatt kell.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
    # HSTS: a böngésző 1 évig csak HTTPS-en kapcsolódik. Csak akkor hagyd bent, ha a HTTPS (és minden aldomain) már működik!
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on' || %{HTTP:X-Forwarded-Proto} == 'https'"

    # Gyorsítótárazás: a hash-elt build-fájlok és a betűtípusok 1 évig, az index.html soha.
    <FilesMatch "\.[0-9a-zA-Z]{8,}\.(js|css)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(woff2|webp|avif|jpg|png|svg|ico)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "^index\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/xml
</IfModule>

<IfModule mod_mime.c>
    AddType font/woff2 .woff2
    AddType image/webp .webp
</IfModule>
