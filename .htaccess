# Angular SPA – Apache beállítások (a build a dist/…/browser mappába másolja)

<IfModule mod_rewrite.c>
    RewriteEngine On

    # HTTPS kényszerítése (proxy / Cloudflare mögött az X-Forwarded-Proto alapján)
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Régi, ?lang=en / ?lang=hu paraméteres címek → az oldal saját nyelvi címe (301, a Google átviszi a jelzéseket).
    RewriteCond %{QUERY_STRING} (^|&)lang=en(&|$)
    RewriteRule ^$ /en? [L,R=301]
    RewriteCond %{QUERY_STRING} (^|&)lang=en(&|$)
    RewriteRule ^tervezo/?$ /en/website-planner? [L,R=301]
    RewriteCond %{QUERY_STRING} (^|&)lang=en(&|$)
    RewriteRule ^ajanlatkeres/?$ /en/request-a-quote? [L,R=301]
    RewriteCond %{QUERY_STRING} (^|&)lang=en(&|$)
    RewriteRule ^projekt-kviz/?$ /en/project-quiz? [L,R=301]
    RewriteCond %{QUERY_STRING} (^|&)lang=en(&|$)
    RewriteRule ^konzultacio/?$ /en/consultation? [L,R=301]
    RewriteCond %{QUERY_STRING} (^|&)lang=en(&|$)
    RewriteRule ^munkak/([A-Za-z0-9_-]+)/?$ /en/work/$1? [L,R=301]
    RewriteCond %{QUERY_STRING} (^|&)lang=en(&|$)
    RewriteRule ^adatkezeles/?$ /en/privacy-policy? [L,R=301]
    RewriteCond %{QUERY_STRING} (^|&)lang=en(&|$)
    RewriteRule ^impresszum/?$ /en/legal-notice? [L,R=301]
    RewriteCond %{QUERY_STRING} (^|&)lang=en(&|$)
    RewriteRule ^aszf/?$ /en/terms? [L,R=301]
    # ?lang=hu: a magyar alapcím.
    RewriteCond %{QUERY_STRING} (^|&)lang=hu(&|$)
    RewriteRule ^(adatkezeles|impresszum|aszf|tervezo|ajanlatkeres|projekt-kviz|konzultacio|munkak/[A-Za-z0-9_-]+)?/?$ /$1? [L,R=301]

    # Oldaltérkép: egyetlen forrás, a Laravel állítja elő (oldalak, szolgáltatások, referenciák, hreflang-párok).
    RewriteRule ^sitemap\.xml$ aurora-api.php [L,QSA]

    # A Laravel backend útvonalai nem az Angularhoz mennek.
    # Rackhost: a Laravel a /private/laravel_mmm mappában van, ezt az aurora-api.php tölti be
    # (az aurora-api.php a szerveren marad, nem része a buildnek – rsyncnél ne töröld!).
    RewriteRule ^(api|sanctum)(/|$) aurora-api.php [L,QSA]
    RewriteRule ^admin/(login|logout|forgot-password|reset-password|verify-login|resend-login-code)$ aurora-api.php [L,QSA]
    RewriteRule ^up$ aurora-api.php [L,QSA]

    # Záró perjel nélküli címek az egyetlen változat (a /weboldal-keszites/ → /weboldal-keszites).
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+)/$ /$1 [L,R=301]

    # Az előre renderelt oldalak (_p/ mappa) közvetlenül nem érhetők el – csak a saját címükön (duplikáció ellen).
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteRule ^_p(/|$) - [R=404,L]

    # Előre renderelt nyilvános oldalak (scripts/prerender.mjs): saját HTML címmel, leírással, canonicallal és tartalommal.
    RewriteCond %{DOCUMENT_ROOT}/_p/index.html -f
    RewriteRule ^$ _p/index.html [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/_p/$1.html -f
    RewriteRule ^(.+)$ _p/$1.html [L]

    # Csak a létező Angular-útvonalak kapnak 200-at; minden más valódi 404-et (lent: ErrorDocument),
    # az Angular ilyenkor is betölt, és a „nem található” oldalt mutatja. Új útvonalnál bővítsd a listát!
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    # (A nyilvános oldalak itt csak tartalékként szerepelnek, ha a _p/ mappa hiányzik, illetve a build után felvett referenciákhoz.)
    RewriteRule ^(utmutatok|utmutatok/(mennyibe-kerul-egy-weboldal|landing-oldal-vagy-ceges-weboldal|weboldal-keszites-lepesei|gyors-es-keresobarat-weboldal)|tervezo|ajanlatkeres|projekt-kviz|konzultacio|konzultacio/foglalasom|adatkezeles|impresszum|aszf|weboldal-keszites|landing-oldal-keszites|webshop-keszites|egyedi-webfejlesztes|weboldal-karbantartas|ugyfel/projekt|fizetes/(sikeres|megszakitva)|admin|admin/(bejelentkezes|elfelejtett-jelszo|jelszo-visszaallitas)|hirlevel/(megerosites|leiratkozas)|munkak/[A-Za-z0-9_-]+|en|en/(website-planner|request-a-quote|project-quiz|consultation|privacy-policy|legal-notice|terms|website-development|landing-page-design|webshop-development|custom-web-development|website-maintenance|work/[A-Za-z0-9_-]+))/?$ index.html [L]
</IfModule>

# Ismeretlen cím: 404-es HTTP-státusz, de a tartalom az Angular alkalmazás (NotFoundPage).
ErrorDocument 404 /index.html

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    # Content-Security-Policy – ÉLES (kényszerített). Csak saját domainről tölthető be szkript, betűtípus és adat;
    # inline szkript és eval tiltva (az XSS elleni fő védelem – ezen múlik az admin és a jelszószéf biztonsága is).
    # Inline stílus az Angular komponensek miatt kell. A Trustindex (Google-vélemények) csak a látogató hozzájárulása
    # után töltődik be. A Cloudflare Turnstile (robotszűrő) szkriptje és iframe-je a challenges.cloudflare.com-ról jön. Ha új külső szolgáltatást kötsz be és nem működik, a böngésző konzolja megmutatja,
    # melyik címet kell ide felvenni.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://cdn.trustindex.io https://*.trustindex.io; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://cdn.trustindex.io https://*.trustindex.io; img-src 'self' data: blob: https://*.trustindex.io https://*.googleusercontent.com; font-src 'self' https://*.trustindex.io; connect-src 'self' https://*.trustindex.io; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
    # HSTS: a böngésző 1 évig csak HTTPS-en kapcsolódik. Csak akkor hagyd bent, ha a HTTPS (és minden aldomain) már működik!
    Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on' || %{HTTP:X-Forwarded-Proto} == 'https'"

    # Gyorsítótárazás: a hash-elt build-fájlok és a betűtípusok 1 évig, az index.html soha.
    <FilesMatch "\.[0-9a-zA-Z]{8,}\.(js|css)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(woff2|webp|avif|jpg|png|svg|ico)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/xml
</IfModule>

<IfModule mod_mime.c>
    AddType font/woff2 .woff2
    AddType image/webp .webp
</IfModule>
